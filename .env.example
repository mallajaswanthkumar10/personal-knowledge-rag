# Required: get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used to answer questions and write digests.
# claude-opus-5 is the most capable, but this tool gets queried often for a
# personal daily-use case - claude-sonnet-5 or claude-haiku-4-5 are much
# cheaper and usually plenty for Q&A over your own short notes. Your call.
ANTHROPIC_MODEL=claude-opus-5

# Where your source notes/documents live (.md, .txt, .pdf)
NOTES_DIR=./data/notes

# Where the vector index is persisted
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=personal_knowledge

# Where generated daily digests are written
DIGEST_DIR=./data/digests

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Retrieval
TOP_K=5
